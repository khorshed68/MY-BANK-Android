<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/chequeNumberText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="27541111622826"
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/accountText"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="2"
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/customerText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="siyam sadikul"
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/amountText"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="0.0"
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="end" />

    <TextView
        android:id="@+id/payeeText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="ISSUED"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/issueDateText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/clearanceDateText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/bounceReasonText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#424242"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="start" />
</LinearLayout>
