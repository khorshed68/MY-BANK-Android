<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/table_row_bg"
    android:padding="12dp">

    <!-- ID -->
    <TextView
        android:id="@+id/tvApplicationId"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="#12345"
        android:textSize="13sp"
        android:textColor="#333333"
        android:gravity="center"/>

    <!-- Customer Name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="John Doe"
        android:textSize="13sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Phone -->
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="+880 1234567890"
        android:textSize="13sp"
        android:textColor="#333333"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

    <!-- Account Type -->
    <TextView
        android:id="@+id/tvAccountType"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="SAVINGS"
        android:textSize="13sp"
        android:textColor="#333333"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

    <!-- Initial Deposit -->
    <TextView
        android:id="@+id/tvInitialDeposit"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="৳ 5,000.00"
        android:textSize="13sp"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

    <!-- Request Date -->
    <TextView
        android:id="@+id/tvRequestDate"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="Jan 03, 2026"
        android:textSize="13sp"
        android:textColor="#333333"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="PENDING"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/status_pending_bg"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="View"
            android:textSize="11sp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnApprove"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✓ Approve"
            android:textSize="11sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnReject"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✗ Reject"
            android:textSize="11sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

</LinearLayout>
