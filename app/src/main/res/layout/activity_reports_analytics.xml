<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E8EAF6">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            android:textColor="#5E35B1"
            android:backgroundTint="@android:color/white"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:strokeColor="#5E35B1"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 REPORTS &amp; ANALYTICS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#5E35B1"
            android:layout_marginStart="16dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>

    </LinearLayout>

    <!-- Report Type and Action Buttons Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:layout_marginTop="2dp"
        android:padding="16dp">

        <!-- First Row: Report Type Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Type:"
                android:textSize="16sp"
                android:textColor="#424242"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/reportTypeSpinner"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

        <!-- Second Row: Generate Report Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/generateReportButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📊 Generate Report"
            android:textColor="@android:color/white"
            android:backgroundTint="#673AB7"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Third Row: Export Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportPdfButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="📄 Export PDF"
                android:textColor="@android:color/white"
                android:backgroundTint="#F44336"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportCsvButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="📊 Export CSV"
                android:textColor="@android:color/white"
                android:backgroundTint="#4CAF50"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Instruction Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a report type and click Generate Report to view data"
        android:textSize="14sp"
        android:textColor="#757575"
        android:padding="16dp"
        android:gravity="start"/>

    <!-- Report Content Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:minHeight="400dp">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 No Data"
                    android:textSize="24sp"
                    android:textColor="#9E9E9E"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generate a report to view data here"
                    android:textSize="16sp"
                    android:textColor="#BDBDBD"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Report Content (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/reportContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/reportTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/reportDataText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#F5F5F5">

        <!-- Available Reports -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Available Reports"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Daily Transaction Reports\n• Account Status Reports\n• Staff Activity Reports\n• User Summary"
                android:textSize="12sp"
                android:textColor="#757575"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

        <!-- Export Options -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 Export Options"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• CSV - Immediate export\n• PDF - Info available"
                android:textSize="12sp"
                android:textColor="#757575"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
