<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/bookNumberText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="BK1767455845485440"
        android:textSize="12sp"
        android:textColor="#424242"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingEnd="8dp"
        android:paddingStart="4dp" />

    <TextView
        android:id="@+id/accountText"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="4"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/customerText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="ABIR HASAN ARKO"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="ISSUED"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/totalLeavesText"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="25"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/remainingText"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="25"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/requestDateText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="2026-01-03 15:57:25.0"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/approvedByText"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Sabbir Sheikh"
        android:textSize="12sp"
        android:textColor="#424242"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="8dp" />
</LinearLayout>
